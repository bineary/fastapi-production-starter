# Copy to .env and fill in real values. The app fails fast at startup if a
# required variable (no default below) is missing or invalid.

# --- App ---
APP_NAME=fastapi-production-starter
# One of: local, test, staging, production
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (required) ---
# Used by host-side tooling (`make migrate`, `make revision`, `make seed`,
# running uvicorn outside Docker). Inside docker compose, the `api` and
# `migrate` services ignore this and connect to the `postgres` service by
# its internal hostname instead (see docker-compose.yml) — that split lets
# this default to `localhost` even if you already have a local Postgres/Redis
# running outside Docker on the standard ports.
# asyncpg DSN: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://taskboard:taskboard@localhost:5433/taskboard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis (required) ---
REDIS_URL=redis://localhost:6380/0

# --- Docker compose host port mapping ---
# Change these if 5433/6380 are also taken. Containers always talk to each
# other over the internal 5432/6379 regardless of this mapping.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Auth / JWT (required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limiting ---
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Observability ---
LOG_LEVEL=INFO
# true = structlog JSON renderer, false = human-readable console renderer
LOG_JSON=true

# --- CORS ---
# JSON array of allowed origins, e.g. ["http://localhost:3000"]
CORS_ALLOW_ORIGINS=[]
